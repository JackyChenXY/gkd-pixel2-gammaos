# Key codes follow the stock Pixel 2 gamepad GPIO map. The stock firmware
# assigns A/B labels opposite the generic Android gamepad convention.
key 114 VOLUME_DOWN
key 115 VOLUME_UP

key 304 BUTTON_B
key 305 BUTTON_A
key 307 BUTTON_X
key 308 BUTTON_Y
key 310 BUTTON_L1
key 311 BUTTON_R1
key 312 BUTTON_L2
key 313 BUTTON_R2
key 314 BUTTON_SELECT
key 315 BUTTON_START

key 544 DPAD_UP
key 545 DPAD_DOWN
key 546 DPAD_LEFT
key 547 DPAD_RIGHT
key 704 MENU
