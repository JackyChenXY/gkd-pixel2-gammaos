<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.gkdpixel2.padnavigation" android:versionCode="2" android:versionName="1.1">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="32" />
    <application android:label="@string/app_name" android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <service android:name=".PadNavigationService" android:label="@string/app_name"
            android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/navigation_service" />
        </service>
    </application>
</manifest>
