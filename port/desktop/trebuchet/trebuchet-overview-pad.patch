+        if (target == null && mOverviewStateEnabled) {
+            TaskView task = getNextPageTaskView();
+            target = task == null ? null : task.getThumbnail();
+        }
+        if (mPadOutlinedView != target) {
+            if (mPadOutlinedView != null) mPadOutlinedView.getOverlay().remove(mPadOutline);
+            mPadOutlinedView = target;
+            if (target != null) {
+                float density = getResources().getDisplayMetrics().density;
+                mPadOutline.setColor(android.graphics.Color.TRANSPARENT);
+                mPadOutline.setCornerRadius(12 * density);
+                mPadOutline.setStroke(Math.max(2, Math.round(3 * density)), 0xff79e4fa);
+                target.getOverlay().add(mPadOutline);
+            }
+        }
+        if (target != null) mPadOutline.setBounds(0, 0, target.getWidth(), target.getHeight());
+    }
