+    private static boolean isPixelPad(KeyEvent event) {
+        InputDevice pad = event.getDevice();
+        return pad != null && "gkd_pixel2_joypad".equals(pad.getName()) && pad.getVendorId() == 1
+                && (pad.getProductId() == 1 || pad.getProductId() == 0x2102);
+    }
+
+    @Override
+    public boolean dispatchKeyEvent(KeyEvent event) {
+        if (isPixelPad(event)) {
+            if (mPadNavigation != null && routePadNavigation(event)) return true;
+            boolean inOverview = isInState(LauncherState.OVERVIEW);
+            if ((inOverview || isInState(NORMAL)) && AbstractFloatingView.getTopOpenView(this) == null) {
+                if (event.getKeyCode() == KeyEvent.KEYCODE_BUTTON_Y) {
+                    if (event.getAction() == KeyEvent.ACTION_UP && !event.isCanceled()) showPadNavigation();
+                    return true;
+                }
+                RecentsView overview = getOverviewPanel();
+                if (inOverview && overview != null && overview.handlePixelPadKey(event)) return true;
+            }
+        }
+        return super.dispatchKeyEvent(event);
+    }
+
+    private void showPadNavigation() {
+        mPadNavigationIndex = 1;
+        mPadConfirmKey = KeyEvent.KEYCODE_UNKNOWN;
+        android.app.AlertDialog dialog = new android.app.AlertDialog.Builder(this)
+                .setSingleChoiceItems(R.array.pixel2_pad_navigation, mPadNavigationIndex,
+                        (d, index) -> runPadNavigation(index))
+                .create();
+        mPadNavigation = dialog;
+        dialog.setOnKeyListener((d, key, event) -> isPixelPad(event) && routePadNavigation(event));
+        dialog.setOnDismissListener(d -> {
+            mPadNavigation = null;
+            mPadConfirmKey = KeyEvent.KEYCODE_UNKNOWN;
+        });
+        dialog.show();
+        android.view.Window window = dialog.getWindow();
+        window.setGravity(android.view.Gravity.END | android.view.Gravity.CENTER_VERTICAL);
+        int width = Math.round(240 * getResources().getDisplayMetrics().density);
+        window.setLayout(width, android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
+    }
+
+    private boolean routePadNavigation(KeyEvent event) {
+        int key = event.getKeyCode();
+        boolean down = event.getAction() == KeyEvent.ACTION_DOWN;
+        switch (key) {
+            case KeyEvent.KEYCODE_DPAD_UP:
+            case KeyEvent.KEYCODE_DPAD_LEFT:
+            case KeyEvent.KEYCODE_DPAD_DOWN:
+            case KeyEvent.KEYCODE_DPAD_RIGHT:
+                if (down) {
+                    int delta = key == KeyEvent.KEYCODE_DPAD_UP || key == KeyEvent.KEYCODE_DPAD_LEFT ? -1 : 1;
+                    mPadNavigationIndex = (mPadNavigationIndex + delta + 3) % 3;
+                    mPadNavigation.getListView().setItemChecked(mPadNavigationIndex, true);
+                    mPadNavigation.getListView().setSelection(mPadNavigationIndex);
+                }
+                return true;
+            case KeyEvent.KEYCODE_DPAD_CENTER:
+            case KeyEvent.KEYCODE_BUTTON_A:
+            case KeyEvent.KEYCODE_BUTTON_B:
+            case KeyEvent.KEYCODE_BUTTON_Y:
+                if (down && event.getRepeatCount() == 0) mPadConfirmKey = key;
+                if (event.getAction() == KeyEvent.ACTION_UP && mPadConfirmKey == key) {
+                    mPadConfirmKey = KeyEvent.KEYCODE_UNKNOWN;
+                    if (!event.isCanceled()) {
+                        if (key == KeyEvent.KEYCODE_BUTTON_B || key == KeyEvent.KEYCODE_BUTTON_Y) {
+                            mPadNavigation.dismiss();
+                        } else {
+                            runPadNavigation(mPadNavigationIndex);
+                        }
+                    }
+                }
+                return true;
+            default:
+                return false;
+        }
+    }
+
+    private void runPadNavigation(int index) {
+        mPadNavigation.dismiss();
+        if (index == 0) {
+            onBackPressed();
+        } else if (index == 1) {
+            RecentsView overview = getOverviewPanel();
+            if (isInState(LauncherState.OVERVIEW) && overview != null) overview.startHome();
+            else getStateManager().goToState(NORMAL);
+        } else if (mOverviewCommandHelper != null && !isInState(LauncherState.OVERVIEW)) {
+            mOverviewCommandHelper.addCommand(OverviewCommandHelper.TYPE_SHOW);
+        }
+    }
+
+    @Override
+    protected void onStop() {
+        if (mPadNavigation != null) mPadNavigation.dismiss();
+        super.onStop();
+    }
