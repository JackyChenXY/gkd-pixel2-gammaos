+    /** Routes the handheld controls while the task carousel is active. */
+    public boolean handlePixelPadKey(KeyEvent event) {
+        int key = event.getKeyCode();
+        boolean down = event.getAction() == KeyEvent.ACTION_DOWN;
+        switch (key) {
+            case KeyEvent.KEYCODE_DPAD_UP:
+            case KeyEvent.KEYCODE_DPAD_DOWN:
+                if (down) {
+                    if (key == KeyEvent.KEYCODE_DPAD_UP) mPadBarAction = View.NO_ID;
+                    else if (mPadBarAction == View.NO_ID && getPadBarAction(R.id.action_screenshot) != null) {
+                        mPadBarAction = R.id.action_screenshot;
+                    }
+                    updatePadOutline();
+                }
+                return true;
+            case KeyEvent.KEYCODE_DPAD_LEFT:
+            case KeyEvent.KEYCODE_DPAD_RIGHT:
+                if (down && mPadBarAction != View.NO_ID) {
+                    int id = ((key == KeyEvent.KEYCODE_DPAD_RIGHT) !=
+                            (mActionsView.getLayoutDirection() == View.LAYOUT_DIRECTION_RTL))
+                            ? R.id.action_clear_all : R.id.action_screenshot;
+                    if (getPadBarAction(id) != null) mPadBarAction = id;
+                    updatePadOutline();
+                } else if (down && mPendingAnimation == null) {
+                    int step = (key == KeyEvent.KEYCODE_DPAD_RIGHT) != mIsRtl ? 1 : -1;
+                    snapToPageRelative(getTaskViewCount(), step, false);
+                    updatePadOutline();
+                }
+                return true;
+            case KeyEvent.KEYCODE_DPAD_CENTER:
+            case KeyEvent.KEYCODE_BUTTON_A:
+            case KeyEvent.KEYCODE_BUTTON_B:
+            case KeyEvent.KEYCODE_BUTTON_X:
+                break;
+            default:
+                return false;
+        }
+        TaskView card = getNextPageTaskView();
+        int taskId = card == null ? -1 : card.getTaskIds()[0];
+        if (down) {
+            if (event.getRepeatCount() == 0) {
+                mPadActionKey = key;
+                mPadActionTaskId = taskId;
+                mPadPressedAction = mPadBarAction;
+            }
+        } else if (event.getAction() == KeyEvent.ACTION_UP && mPadActionKey == key) {
+            mPadActionKey = KeyEvent.KEYCODE_UNKNOWN;
+            if (!event.isCanceled()) {
+                if (key == KeyEvent.KEYCODE_BUTTON_B) {
+                    if (mPadBarAction == View.NO_ID) startHome();
+                    else {
+                        mPadBarAction = View.NO_ID;
+                        updatePadOutline();
+                    }
+                } else if (mPadPressedAction != mPadBarAction) {
+                    return true;
+                } else if (mPadBarAction != View.NO_ID) {
+                    View action = getPadBarAction(mPadBarAction);
+                    if (key != KeyEvent.KEYCODE_BUTTON_X && action != null && mPendingAnimation == null
+                            && taskId == mPadActionTaskId) action.performClick();
+                } else if (taskId != -1 && taskId == mPadActionTaskId && mPendingAnimation == null) {
+                    if (key == KeyEvent.KEYCODE_BUTTON_X) {
+                        dismissTask(card, true, true);
+                    } else {
+                        card.launchTaskAnimated();
+                    }
+                }
+            }
+            mPadActionTaskId = -1;
+        }
+        return true;
+    }
