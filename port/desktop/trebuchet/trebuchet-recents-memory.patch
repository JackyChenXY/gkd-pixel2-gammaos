+package com.android.quickstep.views;
+
+import java.io.BufferedReader;
+import java.io.FileReader;
+import java.io.IOException;
+
+final class OverviewMemoryStats {
+    private static final String TF_SWAP = "/data/pixel2-swap/swapfile";
+    private static final String UNKNOWN = "—";
+
+    private OverviewMemoryStats() {}
+
+    static String availableRam() {
+        try (BufferedReader reader = new BufferedReader(new FileReader("/proc/meminfo"))) {
+            return availableRam(reader);
+        } catch (IOException | SecurityException | NumberFormatException e) {
+            return UNKNOWN;
+        }
+    }
+
+    static String availableRam(BufferedReader reader) throws IOException {
+        long total = -1;
+        long available = -1;
+        String line;
+        while ((line = reader.readLine()) != null) {
+            if (line.startsWith("MemTotal:")) {
+                total = kibField(line);
+            } else if (line.startsWith("MemAvailable:")) {
+                available = kibField(line);
+            }
+            if (total >= 0 && available >= 0) return range(available, total);
+        }
+        return UNKNOWN;
+    }
+
+    private static long kibField(String line) {
+        String[] fields = line.trim().split("\\s+");
+        return fields.length == 3 && "kB".equals(fields[2]) ? Long.parseLong(fields[1]) : -1;
+    }
+
+    /** A null result means the swap table was readable and contained no active TF swapfile. */
+    static String tfSwapUsage() {
+        try (BufferedReader reader = new BufferedReader(new FileReader("/proc/swaps"))) {
+            return tfSwapUsage(reader);
+        } catch (IOException | SecurityException | NumberFormatException e) {
+            return UNKNOWN;
+        }
+    }
+
+    static String tfSwapUsage(BufferedReader reader) throws IOException {
+        String header = reader.readLine();
+        if (header == null || !header.trim().matches("Filename\\s+Type\\s+Size\\s+Used\\s+Priority")) {
+            return UNKNOWN;
+        }
+        String line;
+        while ((line = reader.readLine()) != null) {
+            String[] fields = line.trim().split("\\s+");
+            if (TF_SWAP.equals(fields[0])) {
+                if (fields.length != 5 || !"file".equals(fields[1])) return UNKNOWN;
+                return range(Long.parseLong(fields[3]), Long.parseLong(fields[2]));
+            }
+        }
+        return null;
+    }
+
+    private static String range(long amountKiB, long capacityKiB) {
+        if (capacityKiB <= 0 || amountKiB < 0 || amountKiB > capacityKiB) return UNKNOWN;
+        String amount = amountKiB > 0 && amountKiB < 1024 ? "<1" : Long.toString((amountKiB + 512) / 1024);
+        return amount + " / " + ((capacityKiB + 512) / 1024) + " MiB";
+    }
+}
