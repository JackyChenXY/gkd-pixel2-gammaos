+package com.android.quickstep.views;
+
+import static com.android.launcher3.util.Executors.MAIN_EXECUTOR;
+import static com.android.launcher3.util.Executors.THREAD_POOL_EXECUTOR;
+
+import android.content.Context;
+import android.text.TextUtils;
+import android.view.Gravity;
+import android.widget.TextView;
+
+import com.android.launcher3.R;
+
+final class OverviewMemoryView extends TextView {
+    private final Runnable mRefresh = this::refresh;
+    private int mGeneration;
+    private boolean mVisible;
+
+    OverviewMemoryView(Context context) {
+        super(context);
+        setGravity(Gravity.END);
+        setTextSize(14);
+        setIncludeFontPadding(false);
+        setFocusable(false);
+        setClickable(false);
+        setVisibility(GONE);
+    }
+
+    @Override
+    public void onVisibilityAggregated(boolean visible) {
+        super.onVisibilityAggregated(visible);
+        if (visible == mVisible) return;
+        mVisible = visible;
+        mGeneration++;
+        removeCallbacks(mRefresh);
+        if (visible) refresh();
+    }
+
+    private void refresh() {
+        int generation = mGeneration;
+        THREAD_POOL_EXECUTOR.execute(() -> {
+            String ram = OverviewMemoryStats.availableRam();
+            String swap = OverviewMemoryStats.tfSwapUsage();
+            MAIN_EXECUTOR.execute(() -> {
+                if (!mVisible || generation != mGeneration) return;
+                String memoryLine = getResources().getString(R.string.pixel2_recents_ram_available, ram);
+                String swapLine = swap == null ? getResources().getString(R.string.pixel2_recents_tf_off)
+                        : getResources().getString(R.string.pixel2_recents_tf_used, swap);
+                String text = memoryLine + "\n" + swapLine;
+                if (!TextUtils.equals(getText(), text)) setText(text);
+                postDelayed(mRefresh, 2000);
+            });
+        });
+    }
+}
