+static int
+droid_take_window_buffer_fence(struct dri2_egl_surface *dri2_surf)
+{
+   _EGLDisplay *disp = dri2_surf->base.Resource.Display;
+   struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+   int out = dri2_surf->out_fence_fd;
+   int in = dri2_surf->in_fence_fd;
+
+   dri2_surf->out_fence_fd = -1;
+   if (in < 0 || !droid_uses_native_input_fences(dri2_dpy))
+      return out;
+
+   /* A buffer-age query can dequeue a buffer without creating a DRI image.
+    * Queueing or cancelling that buffer replaces its slot fence. Preserve
+    * the original release fence even if there was no rendering that used it.
+    */
+   dri2_surf->in_fence_fd = -1;
+   if (out < 0 || in == out)
+      return in;
+
+   int merged = sync_merge("droid-window", out, in);
+   if (merged < 0) {
+      /* Keep the rendering fence and drain the input dependency locally. */
+      sync_wait(in, -1);
+      close(in);
+      return out;
+   }
+
+   close(in);
+   close(out);
+   return merged;
+}
