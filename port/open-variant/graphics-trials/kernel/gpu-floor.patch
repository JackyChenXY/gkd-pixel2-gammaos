Subject: drm/panfrost: add opt-in GKD Pixel 2 GPU floor

The Pixel 2 GPU and CPU bus share vdd_logic. Its low GPU OPPs
can prevent a CPU bus speed-up. Let the owner opt into a separate
minimum frequency vote for the board's existing 400 MHz OPP.
Keep the default unchanged and let thermal ceilings take priority.

diff --git a/drivers/gpu/drm/panfrost/panfrost_devfreq.c b/drivers/gpu/drm/panfrost/panfrost_devfreq.c
--- a/drivers/gpu/drm/panfrost/panfrost_devfreq.c
+++ b/drivers/gpu/drm/panfrost/panfrost_devfreq.c
@@ -4,11 +4,117 @@
 #include <linux/clk.h>
 #include <linux/devfreq.h>
 #include <linux/devfreq_cooling.h>
+#include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/pm_opp.h>
+#include <linux/pm_runtime.h>
 
 #include "panfrost_device.h"
 #include "panfrost_devfreq.h"
+
+/*
+ * The Pixel 2 GPU shares vdd_logic with the CPU bus. Its two lowest
+ * OPPs cap the rail below the voltage required for CPU bus speed-up.
+ * Keep this separate from the regular devfreq sysfs vote so that
+ * Android's launch boost can still come and go.
+ */
+#define PIXEL2_GPU_FLOOR_KHZ 400000
+
+static ssize_t pixel2_gpu_floor_show(struct device *dev,
+				    struct device_attribute *attr, char *buf)
+{
+	struct panfrost_device *pfdev = dev_get_drvdata(dev);
+	struct panfrost_devfreq *pfdevfreq = &pfdev->pfdevfreq;
+	bool enabled;
+
+	mutex_lock(&pfdevfreq->pixel2_floor_lock);
+	enabled = pfdevfreq->pixel2_floor_enabled;
+	mutex_unlock(&pfdevfreq->pixel2_floor_lock);
+
+	return sysfs_emit(buf, "%d\n", enabled);
+}
+
+static ssize_t pixel2_gpu_floor_store(struct device *dev,
+				     struct device_attribute *attr,
+				     const char *buf, size_t count)
+{
+	struct panfrost_device *pfdev = dev_get_drvdata(dev);
+	struct panfrost_devfreq *pfdevfreq = &pfdev->pfdevfreq;
+	bool enabled;
+	int ret;
+
+	ret = kstrtobool(buf, &enabled);
+	if (ret)
+		return ret;
+
+	mutex_lock(&pfdevfreq->pixel2_floor_lock);
+	if (enabled == pfdevfreq->pixel2_floor_enabled)
+		goto out;
+
+	/* Updating the QoS request can immediately call the devfreq target. */
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0)
+		goto out;
+
+	ret = dev_pm_qos_update_request(&pfdevfreq->pixel2_floor_req,
+					enabled ? PIXEL2_GPU_FLOOR_KHZ : 0);
+	if (ret >= 0)
+		pfdevfreq->pixel2_floor_enabled = enabled;
+
+	pm_runtime_mark_last_busy(dev);
+	pm_runtime_put_autosuspend(dev);
+out:
+	mutex_unlock(&pfdevfreq->pixel2_floor_lock);
+
+	if (ret < 0)
+		return ret;
+	return count;
+}
+
+static DEVICE_ATTR_RW(pixel2_gpu_floor);
+
+void panfrost_devfreq_pixel2_floor_init(struct panfrost_device *pfdev)
+{
+	struct panfrost_devfreq *pfdevfreq = &pfdev->pfdevfreq;
+	struct device *dev = pfdev->dev;
+	struct dev_pm_opp *opp;
+	int ret;
+
+	if (!pfdevfreq->devfreq ||
+	    !of_machine_is_compatible("gamekiddy,gkd-pixel2"))
+		return;
+
+	opp = dev_pm_opp_find_freq_exact(dev, PIXEL2_GPU_FLOOR_KHZ * 1000UL,
+					true);
+	if (IS_ERR(opp))
+		return;
+	dev_pm_opp_put(opp);
+
+	mutex_init(&pfdevfreq->pixel2_floor_lock);
+	ret = dev_pm_qos_add_request(dev, &pfdevfreq->pixel2_floor_req,
+				    DEV_PM_QOS_MIN_FREQUENCY, 0);
+	if (ret < 0)
+		goto warn;
+
+	ret = device_create_file(dev, &dev_attr_pixel2_gpu_floor);
+	if (!ret)
+		return;
+	dev_pm_qos_remove_request(&pfdevfreq->pixel2_floor_req);
+warn:
+	dev_warn(dev, "Couldn't expose the Pixel 2 GPU floor: %d\n", ret);
+}
+
+void panfrost_devfreq_pixel2_floor_fini(struct panfrost_device *pfdev)
+{
+	struct panfrost_devfreq *pfdevfreq = &pfdev->pfdevfreq;
+
+	if (!dev_pm_qos_request_active(&pfdevfreq->pixel2_floor_req))
+		return;
+
+	/* Wait for all sysfs callbacks before releasing their QoS request. */
+	device_remove_file(pfdev->dev, &dev_attr_pixel2_gpu_floor);
+	dev_pm_qos_remove_request(&pfdevfreq->pixel2_floor_req);
+}
 
 static void panfrost_devfreq_update_utilization(struct panfrost_devfreq *pfdevfreq)
 {
diff --git a/drivers/gpu/drm/panfrost/panfrost_devfreq.h b/drivers/gpu/drm/panfrost/panfrost_devfreq.h
--- a/drivers/gpu/drm/panfrost/panfrost_devfreq.h
+++ b/drivers/gpu/drm/panfrost/panfrost_devfreq.h
@@ -6,6 +6,8 @@
 
 #include <linux/spinlock.h>
 #include <linux/ktime.h>
+#include <linux/mutex.h>
+#include <linux/pm_qos.h>
 
 struct devfreq;
 struct opp_table;
@@ -18,6 +20,10 @@
 	struct opp_table *regulators_opp_table;
 	struct thermal_cooling_device *cooling;
 	bool opp_of_table_added;
+
+	struct dev_pm_qos_request pixel2_floor_req;
+	struct mutex pixel2_floor_lock;
+	bool pixel2_floor_enabled;
 
 	ktime_t busy_time;
 	ktime_t idle_time;
@@ -32,6 +38,8 @@
 
 int panfrost_devfreq_init(struct panfrost_device *pfdev);
 void panfrost_devfreq_fini(struct panfrost_device *pfdev);
+void panfrost_devfreq_pixel2_floor_init(struct panfrost_device *pfdev);
+void panfrost_devfreq_pixel2_floor_fini(struct panfrost_device *pfdev);
 
 void panfrost_devfreq_resume(struct panfrost_device *pfdev);
 void panfrost_devfreq_suspend(struct panfrost_device *pfdev);
diff --git a/drivers/gpu/drm/panfrost/panfrost_drv.c b/drivers/gpu/drm/panfrost/panfrost_drv.c
--- a/drivers/gpu/drm/panfrost/panfrost_drv.c
+++ b/drivers/gpu/drm/panfrost/panfrost_drv.c
@@ -599,6 +599,7 @@
 		goto err_out1;
 
 	panfrost_gem_shrinker_init(ddev);
+	panfrost_devfreq_pixel2_floor_init(pfdev);
 
 	return 0;
 
@@ -620,6 +621,7 @@
 	panfrost_gem_shrinker_cleanup(ddev);
 
 	pm_runtime_get_sync(pfdev->dev);
+	panfrost_devfreq_pixel2_floor_fini(pfdev);
 	pm_runtime_disable(pfdev->dev);
 	panfrost_device_fini(pfdev);
 	pm_runtime_set_suspended(pfdev->dev);
