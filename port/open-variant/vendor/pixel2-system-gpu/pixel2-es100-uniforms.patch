+static bool
+same_unused_es100_uniform_type(const struct gl_shader_program *prog,
+                               const nir_variable *a, const nir_variable *b)
+{
+   /* Mesa's ESSL 1.00 precision check below tolerates a qualifier mismatch
+    * when one stage never uses the uniform. Compare its source-level shape
+    * before treating the compiler's own FP16 lowering as a type mismatch.
+    * Unused declarations are removed before uniform storage is allocated.
+    */
+   if (!prog->IsES || prog->GLSL_Version != 100 ||
+       a->data.mode != nir_var_uniform || b->data.mode != nir_var_uniform ||
+       a->interface_type || b->interface_type ||
+       (a->data.used && b->data.used) ||
+       a->data.precision == b->data.precision ||
+       a->data.lowered_float_uniform == b->data.lowered_float_uniform)
+      return false;
+
+   const glsl_type *lowered = a->data.lowered_float_uniform ? a->type : b->type;
+   const glsl_type *full = a->data.lowered_float_uniform ? b->type : a->type;
+   while (glsl_type_is_array(lowered) && glsl_type_is_array(full)) {
+      if (glsl_get_length(lowered) != glsl_get_length(full) ||
+          glsl_get_explicit_stride(lowered) != glsl_get_explicit_stride(full))
+         return false;
+      lowered = glsl_get_array_element(lowered);
+      full = glsl_get_array_element(full);
+   }
+
+   return glsl_get_base_type(full) == GLSL_TYPE_FLOAT &&
+          glsl_float16_type(full) == lowered;
+}
