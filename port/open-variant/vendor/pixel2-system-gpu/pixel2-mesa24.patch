+/* Buffer-age queries can dequeue a slot without issuing GPU work. Returning
+ * it must preserve the old consumer's fence as well as any rendering fence. */
+static int
+pixel2_take_window_fence(struct dri2_egl_surface *surf)
+{
+   int in = surf->in_fence_fd;
+   int out = surf->out_fence_fd;
+   surf->in_fence_fd = surf->out_fence_fd = -1;
+   if (in < 0 || in == out)
+      return out;
+   if (out < 0)
+      return in;
+   int merged = sync_merge("pixel2-window", out, in);
+   if (merged < 0) {
+      sync_wait(in, -1);
+      close(in);
+      return out;
+   }
+   close(in);
+   close(out);
+   return merged;
 }
 
