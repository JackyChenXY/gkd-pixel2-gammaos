on property:ro.persistent_properties.ready=true && property:ro.product.vendor.device=gkd_pixel2 && property:ro.gsid.image_running=0
    exec u:r:init:s0 root root -- /system/bin/sh /system/etc/pixel2-krkr/check-layout.sh

on property:sys.pixel2.krkr_layout=valid
    mount none /system/etc/pixel2-krkr/odm-lib /odm/lib bind
    setprop wrap.org.github.krkr2 "/system/bin/sh /system/etc/pixel2-krkr/launch.sh"
