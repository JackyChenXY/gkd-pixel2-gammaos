+/* Single-level, unshared Mali-G31 RGBA8 with linear AFBC headers only.
+ * Retain the original header bits plus the locations and lengths of meaningful
+ * body bytes. The GPU can only sample the packed allocation. */
+struct p2_raw_tile {
+   uint32_t header[4], compact, bytes;
+};
+struct p2_raw_record {
+   struct pan_image_layout layout;
+   struct panfrost_bo *owner; /* Borrowed from the resource; never dereference. */
+   unsigned nr, bytes, non_solid;
+   struct p2_raw_tile tile[];
+};
+static unsigned
+p2_body_bytes(const uint32_t h[4])
+{
+   if (!(h[1] & 63))
+      return 0;
+   unsigned size = 0;
+   for (unsigned i = 0; i < 16; ++i) {
+      unsigned pos = i * 6, off = pos & 31, w = 1 + pos / 32;
+      uint32_t n = h[w] >> off;
+      if (off > 26) n |= h[w + 1] << (32 - off);
+      n &= 63;
+      size += n == 1 ? 64 : n; /* 4x4 RGBA8 uncompressed subblock */
+   }
+   return ALIGN_POT(size, 16);
+}
+static bool
+p2_fits(size_t offset, size_t count, size_t limit)
+{
+   return offset <= limit && count <= limit - offset;
+}
+static bool
+p2_raw_pack(struct panfrost_context *ctx, struct panfrost_resource *r,
+            struct panfrost_bo *dst, const struct pan_image_slice_layout *packed,
+            const struct pan_afbc_block_info *meta, unsigned compact_size,
+            uint64_t modifier)
+{
