+   if (s->p2_contexts_ever!=1) {++s->p2_multi; goto summary;}
+   if (ctx->p2_lost) goto summary;
+   if (slow) ++s->p2_burst_opportunities;
+   if (!prealloc && s->p2_attempts && now-s->p2_last_attempt<250) goto summary;
+   while (attempts<cap) {
