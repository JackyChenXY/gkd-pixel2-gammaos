+            struct pipe_sampler_view *view=(struct pipe_sampler_view *)ctx->sampler_views[PIPE_SHADER_FRAGMENT][i];
+            if (!view) continue;
+            ++s->p2_bound;
+            struct panfrost_resource *item=pan_resource(view->texture);
+            if (p2_eligible_now(ctx,item,now)) {r=item;break;}
+         }
+      }
+      if (!r) break;
