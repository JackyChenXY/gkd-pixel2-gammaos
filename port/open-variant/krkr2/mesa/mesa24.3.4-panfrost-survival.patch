+   bool slow=s->p2_defer>=2 && gap>=P2_BURST_GAP_MS;
+   unsigned cap=prealloc ? P2_PRESSURE_CAP : (slow ? P2_BURST_CAP : 1);
+   unsigned attempts=0, packed=0;
