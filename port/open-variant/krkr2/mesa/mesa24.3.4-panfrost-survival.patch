+/* Device trial: sample only the allocation site that can have two live BOs. */
+enum pixel2_shadow_mode {
+   PIXEL2_SHADOW_DEFAULT, PIXEL2_SHADOW_OBSERVE, PIXEL2_SHADOW_INPLACE
+};
+
+static unsigned
+pixel2_shadow_mode(void)
+{
+   const char *mode = getenv("PIXEL2_SHADOW_MODE");
+#ifdef ANDROID
+   char prop[PROP_VALUE_MAX];
+   if (!mode) {
+      char name[17] = {0};
+      int fd = open("/proc/self/cmdline", O_RDONLY | O_CLOEXEC);
+      if (fd < 0)
+         return PIXEL2_SHADOW_DEFAULT;
+      ssize_t n = read(fd, name, sizeof(name));
+      close(fd);
+      const char target[] = "org.github.krkr2";
+      if (n < (ssize_t)sizeof(target) ||
+          memcmp(name, target, sizeof(target)) != 0)
+         return PIXEL2_SHADOW_DEFAULT;
+      if (!__system_property_get("debug.pixel2.krkr.shadow", prop))
+         return PIXEL2_SHADOW_DEFAULT;
+      mode = prop;
+   }
+#endif
+   if (!mode)
+      return PIXEL2_SHADOW_DEFAULT;
+   if (strcmp(mode, "observe") == 0)
+      return PIXEL2_SHADOW_OBSERVE;
+   if (strcmp(mode, "inplace") == 0)
+      return PIXEL2_SHADOW_INPLACE;
+   return PIXEL2_SHADOW_DEFAULT;
+}
