+   if (!r->bo->ptr.cpu || !dst->ptr.cpu) return false;
+   struct p2_raw_record *m = malloc(mapsize);
+   if (!m) return false;
+   m->layout = *layout; m->owner = dst; m->nr = nr; m->bytes = mapsize; m->non_solid = 0;
+   const uint8_t *src = r->bo->ptr.cpu;
+   uint8_t *out = dst->ptr.cpu;
+   unsigned offset = packed->afbc.header_size;
+   memset(out, 0, packed->afbc.header_size);
