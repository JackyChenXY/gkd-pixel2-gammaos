+static pthread_mutex_t pixel2_shadow_lock = PTHREAD_MUTEX_INITIALIZER;
+static unsigned pixel2_seen_modes;
+static uint64_t pixel2_candidates[3], pixel2_requested[3], pixel2_largest[3],
+                pixel2_pair_peak[3], pixel2_actual[3], pixel2_render[3],
+                pixel2_texture[3], pixel2_copy[3], pixel2_failed[3];
+static int64_t pixel2_last_log[3];
+
+static void
+pixel2_shadow_ready(unsigned mode)
+{
+   if (!mode)
+      return;
+   pthread_mutex_lock(&pixel2_shadow_lock);
+   if (!(pixel2_seen_modes & (1u << mode))) {
+      pixel2_seen_modes |= 1u << mode;
+      mesa_logi("P2Shadow ready mode=%s min_bytes=1048576",
+                mode == PIXEL2_SHADOW_INPLACE ? "inplace" : "observe");
+   }
+   pthread_mutex_unlock(&pixel2_shadow_lock);
+}
+
+static void
+pixel2_shadow_record(unsigned mode, unsigned bind, uint64_t old_size,
+                     uint64_t new_size, bool copy)
+{
+   pthread_mutex_lock(&pixel2_shadow_lock);
+   uint64_t n = ++pixel2_candidates[mode];
+   pixel2_requested[mode] += old_size;
+   pixel2_largest[mode] = MAX2(pixel2_largest[mode], old_size);
+   if (bind & PIPE_BIND_RENDER_TARGET)
