+                             AFBC_FORMAT_MOD_YTR | AFBC_FORMAT_MOD_SPARSE);
+   if (pan_device(r->base.screen)->arch != 7 || !p2_new_candidate(r) ||
+       r->p2_raw || layout->modifier != original || r->image.data.offset ||
+       layout->data_size > panfrost_bo_size(r->bo) || s->offset || packed->offset ||
