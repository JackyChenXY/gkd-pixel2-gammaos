+      pixel2_last_log[mode] = ts.tv_sec;
+      mesa_logi("P2Shadow mode=%s candidates=%" PRIu64
+                " requested_bytes=%" PRIu64 " largest_bytes=%" PRIu64
+                " actual_pairs=%" PRIu64 " peak_pair_bytes=%" PRIu64
+                " copied_bytes=%" PRIu64 " alloc_fail=%" PRIu64
+                " rt_bind=%" PRIu64 " sampler_only=%" PRIu64 " other=%" PRIu64,
+                mode == PIXEL2_SHADOW_INPLACE ? "inplace" : "observe", n,
+                pixel2_requested[mode], pixel2_largest[mode], pixel2_actual[mode],
+                pixel2_pair_peak[mode], pixel2_copy[mode], pixel2_failed[mode],
+                pixel2_render[mode], pixel2_texture[mode],
+                n - pixel2_render[mode] - pixel2_texture[mode]);
+   }
+   pthread_mutex_unlock(&pixel2_shadow_lock);
