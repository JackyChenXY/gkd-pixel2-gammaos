+static unsigned
+p2_pool_mode(void)
+{
+   const char *mode = getenv("PIXEL2_RESOURCE_TRACE");
+#ifdef ANDROID
+   char prop[PROP_VALUE_MAX];
+   if (!mode) {
+      const char target[] = "org.github.krkr2";
+      char name[sizeof(target)];
+      int fd = open("/proc/self/cmdline", O_RDONLY | O_CLOEXEC);
+      if (fd < 0)
+         return 0;
+      ssize_t n = read(fd, name, sizeof(name));
+      close(fd);
+      if (n != sizeof(name) || memcmp(name, target, sizeof(target)) != 0 ||
+          !__system_property_get("debug.pixel2.krkr.resources", prop))
+         return 0;
+      mode = prop;
+   }
+#endif
+   if (!mode) return 0;
+   if (!strcmp(mode, "summary")) return 1;
+   if (!strcmp(mode, "large")) return 2;
+   if (!strcmp(mode, "all")) return 3;
+   return 0;
+}
