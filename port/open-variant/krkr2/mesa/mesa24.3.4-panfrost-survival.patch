+static unsigned
+p2_kind(const struct panfrost_resource *r)
+{
+   unsigned b = r->base.bind;
+   if (r->p2_import || (r->bo->flags & PAN_BO_SHARED) ||
+       (b & (PIPE_BIND_SCANOUT|PIPE_BIND_DISPLAY_TARGET|PIPE_BIND_SHARED)))
+      return P2_EXTERNAL;
+   if (r->base.target == PIPE_BUFFER) return P2_BUFFER;
+   if (b & PIPE_BIND_DEPTH_STENCIL) return P2_DEPTH;
+   if (b & PIPE_BIND_RENDER_TARGET)
+      return (b & PIPE_BIND_SAMPLER_VIEW) ? P2_RENDER_SAMPLE : P2_RENDER;
+   return (b & PIPE_BIND_SAMPLER_VIEW) ? P2_SAMPLE : P2_OTHER;
+}
