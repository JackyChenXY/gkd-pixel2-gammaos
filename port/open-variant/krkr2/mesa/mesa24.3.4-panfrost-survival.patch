+      }
+      if (ctx->p2_lost) break;
+      struct panfrost_resource *r=NULL;
+      if (s->p2_defer >= 2) {
+         /* Hold each selected registry resource through the outer flush. */
+         pthread_mutex_lock(&p2_recent_lock);
+         struct panfrost_resource *best=NULL;
+         list_for_each_entry(struct panfrost_resource, item, &s->p2_recent_list,p2_recent_link) {
+            ++s->p2_recent_walked;
+            if (!p_atomic_read(&item->base.reference.count)) {++s->p2_unreferenced;continue;}
+            if (!survival && now-p_atomic_read(&item->p2_last_sample)>4000) {++s->p2_expired;continue;}
