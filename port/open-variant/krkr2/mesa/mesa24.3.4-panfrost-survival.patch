+/* Per-wrapper layout and BO capacity. Objects shared by multiple wrappers
+ * intentionally contribute to each category; the optional event stream carries
+ * stable per-resource IDs plus device/handle pairs for host-side deduplication. */
+static void
+p2_account(struct panfrost_resource *r, const char *reason, bool destroy)
+{
+   if (!r->p2_mode) return;
+   pthread_mutex_lock(&p2_mutex);
+   if (!p2_started) {
+      p2_started = true;
+      mesa_logi("P2Pool ready mode=%u summary=count/logical/capacity/peakLogical/peakCapacity", r->p2_mode);
+   }
+   if (!r->p2_id)
+      r->p2_id = ++p2_next_resource;
+   uint64_t before = r->p2_capacity;
+   if (r->p2_live) {
+      struct p2_total *t = &p2_totals[r->p2_kind];
+      t->count--; t->logical -= r->p2_layout; t->capacity -= before;
+   }
+   if (!destroy) {
+      r->p2_kind = p2_kind(r);
+      r->p2_layout = r->image.layout.data_size;
+      r->p2_capacity = panfrost_bo_size(r->bo);
+      struct p2_total *t = &p2_totals[r->p2_kind];
+      t->count++; t->logical += r->p2_layout; t->capacity += r->p2_capacity;
+      t->peak_logical = MAX2(t->peak_logical, t->logical);
+      t->peak_capacity = MAX2(t->peak_capacity, t->capacity);
+   }
+   bool emit = r->p2_mode == 3 || (r->p2_mode == 2 &&
+               MAX2(before, r->p2_capacity) >= (1u<<20));
+   if (emit) {
+      mesa_logi("P2Pool ev=%" PRIu64 " id=%" PRIu64 " op=%s c=%s dev=%p bo=%u layout=%" PRIu64
+                " cap=%" PRIu64 " fmt=%s whd=%ux%ux%u layers=%u samples=%u levels=%u mod=%" PRIx64
+                " bind=%x imported=%u target=%u",
+                ++p2_event_seq, r->p2_id, reason, p2_names[r->p2_kind],
+                (void *)r->bo->dev, panfrost_bo_handle(r->bo), r->p2_layout, r->p2_capacity,
+                util_format_name(r->image.layout.format), r->base.width0,
+                r->base.height0, r->base.depth0, r->base.array_size,
+                MAX2(1,r->base.nr_samples), r->base.last_level + 1,
+                r->image.layout.modifier, r->base.bind, r->p2_import, (unsigned)r->base.target);
+   }
+   r->p2_live = !destroy;
+   ++p2_updates;
+   struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+   if (p2_updates <= 2 || ts.tv_sec - p2_last_snapshot >= 2) {
+      p2_last_snapshot = ts.tv_sec;
+      char out[1024]; size_t used=0;
+      for (unsigned i=0; i<P2_KINDS; ++i) {
+         const struct p2_total *t = &p2_totals[i];
+         int n = snprintf(out+used, sizeof(out)-used,
+                          " %s=%u/%" PRIu64 "/%" PRIu64 "/%" PRIu64 "/%" PRIu64,
+                          p2_names[i], t->count, t->logical, t->capacity,
+                          t->peak_logical, t->peak_capacity);
+         if (n<0 || (size_t)n>=sizeof(out)-used) break;
+         used+=(size_t)n;
+      }
+      mesa_logi("P2Pool sum=%" PRIu64 " ev=%" PRIu64 "%s",p2_updates,p2_event_seq,out);
+   }
+   pthread_mutex_unlock(&p2_mutex);
+}
