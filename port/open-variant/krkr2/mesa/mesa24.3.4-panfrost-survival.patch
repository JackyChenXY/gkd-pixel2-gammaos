+       packed->afbc.header_size > compact_size || packed->size > compact_size ||
+       !nr || nr > 32768 || nr != packed->afbc.nr_blocks ||
+       s->afbc.stride != packed->afbc.stride ||
+       !p2_fits(0, (size_t)nr * 16, s->afbc.header_size) ||
+       !p2_fits(0, (size_t)nr * 16, packed->afbc.header_size))
+      return false;
+   size_t mapsize = sizeof(struct p2_raw_record) + nr * sizeof(struct p2_raw_tile);
+   if (100ull * (panfrost_bo_size(dst) + mapsize) > 75ull * panfrost_bo_size(r->bo))
+      return false;
+   if (!panfrost_bo_wait(r->bo, INT64_MAX, true))
+      return false;
