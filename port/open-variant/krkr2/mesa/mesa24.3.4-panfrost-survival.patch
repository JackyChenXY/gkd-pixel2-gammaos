+   p2_account(r, "raw_restore", false);
+   mesa_logi("P2AFBC raw-restore id=%" PRIu64 " blocks=%u non_solid=%u map=%u",
+             r->p2_id, m->nr, m->non_solid, m->bytes);
+   free(m); panfrost_bo_unreference(compact);
+   return true;
+}
