+             r->p2_id, nr, m->non_solid, m->bytes);
+   return true;
+}
+static bool
+p2_raw_restore(struct panfrost_resource *r)
+{
+   struct p2_raw_record *m = r->p2_raw;
+   if (!m) return true;
+   /* A full-resource rename has already discarded this representation. */
+   if (r->bo != m->owner ||
+       r->image.layout.modifier != (m->layout.modifier & ~AFBC_FORMAT_MOD_SPARSE)) {
+      free(m); r->p2_raw = NULL; return true;
+   }
+   if (!panfrost_bo_wait(r->bo, INT64_MAX, true)) return false;
+   struct panfrost_bo *sparse = panfrost_bo_create(pan_device(r->base.screen),
+                                        m->layout.data_size, 0, "AFBC restore");
+   if (!sparse || !sparse->ptr.cpu) {
+      if (sparse) panfrost_bo_unreference(sparse);
+      return false;
+   }
+   const struct pan_image_slice_layout *s = &m->layout.slices[0];
+   const struct pan_image_slice_layout *p = &r->image.layout.slices[0];
+   uint8_t *out = sparse->ptr.cpu;
+   const uint8_t *src = r->bo->ptr.cpu;
+   if (!src || s->size > panfrost_bo_size(sparse) || p->size > panfrost_bo_size(r->bo)) {
+      panfrost_bo_unreference(sparse); return false;
+   }
+   memset(out, 0, s->afbc.header_size);
+   for (unsigned i = 0; i < m->nr; ++i) {
+      const struct p2_raw_tile *t = &m->tile[i];
+      unsigned old = t->header[0];
+      uint32_t h[4];
+      memcpy(h, t->header, 16);
+      if (old) h[0] = t->compact;
+      if (memcmp(src + i * 16, h, 16) ||
+          !p2_fits(t->compact, t->bytes, p->size) ||
+          (t->bytes && !p2_fits(old, t->bytes, s->size))) {
+         panfrost_bo_unreference(sparse); return false;
+      }
+      memcpy(out + i * 16, t->header, 16);
+      if (t->bytes) memcpy(out + old, src + t->compact, t->bytes);
