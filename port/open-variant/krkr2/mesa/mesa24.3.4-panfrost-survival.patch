+         r->p2_tried=true;
+         ctx->p2_inside_pack=true;
+         ++attempts;
+         ++s->p2_attempts; s->p2_last_attempt=now;
+         uint64_t before=panfrost_bo_size(r->bo);
+         mesa_logi("P2AFBC attempt=%" PRIu64 " id=%" PRIu64 " size=%" PRIu64 " wh=%ux%u",
+                   s->p2_attempts,r->p2_id,before,r->base.width0,r->base.height0);
+         panfrost_pack_afbc(ctx,r);
+         ctx->p2_inside_pack=false;
+         uint64_t after=panfrost_bo_size(r->bo);
+         bool changed=!(r->image.layout.modifier & AFBC_FORMAT_MOD_SPARSE);
+         if (changed) {
+            ++packed;
+            if (!p_atomic_read(&r->p2_sampled)) ++unsampled;
+            ++s->p2_success;s->p2_before+=before;s->p2_after+=after;
+            panfrost_dirty_state_all(ctx);
+         }
+         mesa_logi("P2AFBC result id=%" PRIu64 " packed=%u before=%" PRIu64 " after=%" PRIu64,
+                   r->p2_id,changed,before,after);
+      }
+   }
+   now=p2_ms();
+   if (prealloc)
+      mesa_logi("P2Survival prealloc=%" PRIu64 " attempted=%u packed=%u before_first_sample=%u elapsed_ms=%u",
+                s->p2_flushes, attempts, packed, unsampled, now-start);
+   if (attempts>1) {
+      ++s->p2_burst_multi;
+      s->p2_burst_extra+=attempts-1;
+   }
+   if (slow && attempts)
+      mesa_logi("P2Burst flush=%" PRIu64 " gap_ms=%u cap=%u attempts=%u packed=%u elapsed_ms=%u budget_hit=%u",
+                s->p2_flushes,gap,cap,attempts,packed,now-start,budget_hit);
+summary:
+   if (!s->p2_last_stats || now-s->p2_last_stats>=5000) {
+      s->p2_last_stats=now;
+      if (s->p2_defer==2)
+         mesa_logi("P2Burst stats opportunities=%" PRIu64 " multi=%" PRIu64
