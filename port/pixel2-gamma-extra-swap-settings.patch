+package com.android.settings.system;
+
+import android.content.Context;
+import android.os.SystemProperties;
+import android.util.Log;
+import android.widget.Toast;
+
+import androidx.preference.Preference;
+import androidx.preference.TwoStatePreference;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+
+public class Pixel2VirtualMemoryPreferenceController extends BasePreferenceController
+        implements Preference.OnPreferenceChangeListener {
+
+    private static final String TAG = "Pixel2VirtualMemory";
+    private static final String REQUEST_PROPERTY = "persist.sys.pixel2.extra_swap";
+    private static final String STATUS_PROPERTY = "sys.pixel2.extra_swap.status";
+
+    public Pixel2VirtualMemoryPreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        final boolean supported =
+                "gkd_pixel2".equals(SystemProperties.get("ro.product.vendor.device"))
+                && SystemProperties.getBoolean("ro.pixel2.extra_swap.supported", false)
+                && !SystemProperties.getBoolean("ro.gsid.image_running", false);
+        return supported ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        if (preference instanceof TwoStatePreference) {
+            ((TwoStatePreference) preference).setChecked(isRequested());
+        }
+        super.updateState(preference);
+    }
+
+    @Override
+    public CharSequence getSummary() {
+        final int request = isRequested()
+                ? R.string.pixel2_virtual_memory_next_enabled
+                : R.string.pixel2_virtual_memory_next_disabled;
+        return mContext.getString(R.string.pixel2_virtual_memory_summary,
+                mContext.getString(getStatusMessage()), mContext.getString(request));
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        if (!isAvailable() || !(newValue instanceof Boolean)) {
+            return false;
+        }
+        try {
+            SystemProperties.set(REQUEST_PROPERTY, Boolean.toString((boolean) newValue));
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Could not save the virtual memory request", e);
+            Toast.makeText(mContext, R.string.pixel2_virtual_memory_write_failed,
+                    Toast.LENGTH_SHORT).show();
+            return false;
+        }
+        refreshSummary(preference);
+        return true;
+    }
+
+    private boolean isRequested() {
+        return SystemProperties.getBoolean(REQUEST_PROPERTY, false);
+    }
+
+    private int getStatusMessage() {
+        switch (SystemProperties.get(STATUS_PROPERTY)) {
+            case "active":
+                return R.string.pixel2_virtual_memory_active;
+            case "disabled":
+                return R.string.pixel2_virtual_memory_disabled;
+            case "insufficient_space":
+                return R.string.pixel2_virtual_memory_insufficient_space;
+            case "failed":
+                return R.string.pixel2_virtual_memory_failed;
+            default:
+                return R.string.pixel2_virtual_memory_pending;
+        }
+    }
+}
