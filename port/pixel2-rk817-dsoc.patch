+/* Reconcile the Pixel 2's stale near-empty display value at boot. */
+static int rk817_bat_recover_pixel2_dsoc(struct rk817_battery_device *battery,
+					int dsoc, int saved_cap, int counter_cap)
+{
+	int fcc = battery->fcc;
+	int voltage, counter_soc;
+
+	if (!of_machine_is_compatible("GameKiddy,gkd-pixel2") ||
+	    dsoc < 0 || dsoc > 1000 || fcc < MIN_FCC)
+		return dsoc;
+	if (saved_cap < fcc / 2 || saved_cap > fcc ||
+	    counter_cap < fcc / 2 || counter_cap > fcc ||
+	    abs(saved_cap - counter_cap) > fcc / 10)
+		return dsoc;
+
+	voltage = rk817_bat_get_battery_voltage(battery);
+	if (voltage < SLP_DSOC_VOL_THRESD ||
+	    rk817_bat_vol_to_soc(battery, voltage) < MAX_PERCENTAGE / 2)
+		return dsoc;
+
+	counter_soc = div_s64((s64)counter_cap * 1000 * MAX_PERCENTAGE, fcc);
+	if (counter_soc - dsoc < battery->pdata->max_soc_offset * 1000)
+		return dsoc;
+
+	BAT_INFO("Pixel 2: recovered cached display SOC %d -> %d\n",
+		 dsoc, counter_soc);
+	return counter_soc;
+}
