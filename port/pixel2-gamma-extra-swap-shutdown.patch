+static void ReleasePixel2DiskSwap() {
+    if (!GetBoolProperty("ro.pixel2.extra_swap.supported", false) ||
+        GetBoolProperty("ro.gsid.image_running", false) ||
+        android::base::GetProperty("ro.product.vendor.device", "") != "gkd_pixel2") {
+        return;
+    }
+
+    const char* args[] = {"/system/bin/pixel2-extra-swap", "shutdown"};
+    int status;
+    if (logwrap_fork_execvp(arraysize(args), args, &status, false, LOG_KLOG, true, nullptr) != 0) {
+        PLOG(WARNING) << "Unable to start the Pixel 2 disk swap shutdown helper";
+    } else if (!WIFEXITED(status) || WEXITSTATUS(status) != 0) {
+        LOG(WARNING) << "Unable to release the Pixel 2 disk swap: " << status;
+    }
+}
